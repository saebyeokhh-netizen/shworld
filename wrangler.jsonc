{
  // shworld — 정적 자산 + /api/* 를 한 Worker 에서 처리한다.
  // 스키마 참고: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "wonderful",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 관측: 배포 후 `wrangler tail` 로 로그를 볼 수 있게 켜 둔다.
  "observability": {
    "enabled": true
  },

  // Vite 빌드 산출물(dist/)을 서빙한다. Worker 코드가 있으면
  // /api/* 는 Worker 가 먼저 처리하고, 나머지는 env.ASSETS.fetch() 로 넘긴다.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 매칭되는 자산이 없으면 dist/404.html 을 404 상태로 응답
    "not_found_handling": "404-page",
    // /projects/foo → /projects/foo.html 로 해석 (확장자 없는 URL 지원)
    "html_handling": "auto-trailing-slash",
    // 정적 자산 요청이 Worker 를 거치지 않게 해서 요청 과금을 줄인다
    "run_worker_first": ["/api/*"]
  },

  /*
   * 도메인 맨 위를 이 워커가 맡는다.
   *
   * 게임(메두사 미용실)이 여기 있었는데, 애드센스가 "가치가 별로 없는 콘텐츠" 로 사이트를
   * 반려했다. 게임 앱은 심사 로봇 눈에 글이 하나도 없는 백지로 보이기 때문이다. 그래서
   * 맨 위는 읽을거리가 있는 이 사이트가 맡고, 게임은 `/m-hairsalon` 아래로 내려간다.
   *
   * ⚠️ 게임 경로는 더 구체적인 라우트(`m-hairsalon-proxy` 워커)가 가져간다. Cloudflare 는
   *    겹치는 라우트 중 **더 구체적인 쪽**을 고르므로, 이 `/*` 가 게임을 가리지 않는다.
   *    다만 그 워커가 먼저 배포돼 있어야 한다 — 순서가 바뀌면 게임이 잠깐 안 열린다.
   */
  "routes": [
    { "pattern": "shworld.cloud/*", "zone_name": "shworld.cloud" },
    { "pattern": "www.shworld.cloud/*", "zone_name": "shworld.cloud" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shworld-db",
      "database_id": "d3c54f19-873b-41cd-b445-5e1358943f40",
      "migrations_dir": "migrations"
    }
  ],

  // 공개해도 되는 값만 vars 에 둔다. Turnstile "사이트 키"는 공개값이다.
  // 시크릿(TURNSTILE_SECRET / ADMIN_TOKEN / IP_SALT)은 절대 여기 쓰지 말고
  // 로컬은 .dev.vars, 운영은 `wrangler secret put` 을 쓴다.
  "vars": {
    // 운영 사이트 키(공개값). 프론트는 src/js/turnstile.js 의 SITE_KEY 기본값을 쓰므로
    // 키를 바꿀 때는 그쪽도 함께 교체할 것.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEWyIkOakKUZLcAp"
  }
}
