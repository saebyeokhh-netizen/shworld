{
  // shworld — 정적 자산 + /api/* 를 한 Worker 에서 처리한다.
  // 스키마 참고: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "shworld",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 관측: 배포 후 `wrangler tail` 로 로그를 볼 수 있게 켜 둔다.
  "observability": {
    "enabled": true
  },

  // Vite 빌드 산출물(dist/)을 서빙한다. Worker 코드가 있으면
  // /api/* 는 Worker 가 먼저 처리하고, 나머지는 env.ASSETS.fetch() 로 넘긴다.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 매칭되는 자산이 없으면 dist/404.html 을 404 상태로 응답
    "not_found_handling": "404-page",
    // /projects/foo → /projects/foo.html 로 해석 (확장자 없는 URL 지원)
    "html_handling": "auto-trailing-slash",
    // 정적 자산 요청이 Worker 를 거치지 않게 해서 요청 과금을 줄인다
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shworld-db",
      // TODO: `wrangler d1 create shworld-db` 실행 후 출력된 database_id 를 여기에 붙여넣을 것.
      //       (이 값이 placeholder 인 동안 --local 개발은 되지만 --remote / deploy 는 실패한다)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // 공개해도 되는 값만 vars 에 둔다. Turnstile "사이트 키"는 공개값이다.
  // 시크릿(TURNSTILE_SECRET / ADMIN_TOKEN / IP_SALT)은 절대 여기 쓰지 말고
  // 로컬은 .dev.vars, 운영은 `wrangler secret put` 을 쓴다.
  "vars": {
    // 기본값은 Cloudflare 공식 테스트 사이트 키(항상 통과).
    // 실제 키로 바꿀 때는 프론트 주입값(.env 의 VITE_TURNSTILE_SITE_KEY)도 함께 교체할 것.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
